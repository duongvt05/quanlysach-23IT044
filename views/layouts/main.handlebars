<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Quản lý Sách</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>📚</text></svg>">
  <style>
    :root{
      --bg:#f4f6fb; --card:#ffffff; --text:#1e293b; --muted:#64748b;
      --border:#e2e8f0; --primary:#4f46e5; --primary-hover:#4338ca;
      --th:#f1f5f9; --row-hover:#f8fafc;
      --ok-bg:#dcfce7; --ok-text:#166534; --ok-border:#86efac;
      --err-bg:#fee2e2; --err-text:#991b1b; --err-border:#fca5a5;
      --badge-bg:#e0e7ff; --badge-text:#3730a3;
      --shadow:0 1px 3px rgba(15,23,42,.08),0 8px 24px rgba(15,23,42,.06);
    }
    @media (prefers-color-scheme: dark){
      :root{
        --bg:#0f172a; --card:#1e293b; --text:#e2e8f0; --muted:#94a3b8;
        --border:#334155; --primary:#6366f1; --primary-hover:#818cf8;
        --th:#273449; --row-hover:#243247;
        --ok-bg:#14532d; --ok-text:#bbf7d0; --ok-border:#166534;
        --err-bg:#7f1d1d; --err-text:#fecaca; --err-border:#991b1b;
        --badge-bg:#312e81; --badge-text:#c7d2fe;
        --shadow:0 1px 3px rgba(0,0,0,.4);
      }
    }
    *{box-sizing:border-box}
    body{
      margin:0; background:var(--bg); color:var(--text);
      font-family:"Segoe UI",system-ui,-apple-system,Roboto,Arial,sans-serif;
      line-height:1.5; min-height:100vh; display:flex; flex-direction:column;
    }
    header.top{
      background:linear-gradient(135deg,#4f46e5,#7c3aed);
      color:#fff; padding:28px 20px;
    }
    .wrap{max-width:1000px; margin:0 auto; padding:0 20px}
    header.top .wrap{padding:0}
    header.top h1{margin:0; font-size:1.8rem; letter-spacing:-.5px}
    header.top p{margin:4px 0 0; opacity:.85; font-size:.95rem}
    main{flex:1; padding:28px 0}
    .card{
      background:var(--card); border:1px solid var(--border);
      border-radius:14px; box-shadow:var(--shadow);
      padding:24px; margin-bottom:24px;
    }
    .card h2{margin:0 0 16px; font-size:1.15rem}
    .card-head{display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; margin-bottom:16px}
    .card-head h2{margin:0}
    footer.site{
      background:var(--card); border-top:1px solid var(--border);
      padding:18px 20px; text-align:center; font-size:.92rem;
    }
    footer.site strong{color:var(--primary)}
    footer.site .sep{margin:0 8px; color:var(--muted)}
    @media (max-width:520px){
      footer.site .sep{display:none}
      footer.site span.item{display:block}
    }
  </style>
</head>
<body>
  <header class="top">
    <div class="wrap">
      <h1>📚 Quản lý Sách</h1>
      <p>Ứng dụng Cloud · MongoDB Atlas · Stateless Session</p>
    </div>
  </header>

  <main>
    <div class="wrap">
      {{{body}}}
    </div>
  </main>

  <footer class="site">
    <span class="item">Sinh viên: <strong>{{student.name}}</strong></span>
    <span class="sep">|</span>
    <span class="item">MSSV: <strong>{{student.mssv}}</strong></span>
    <span class="sep">|</span>
    <span class="item">VAT áp dụng: <strong>{{student.vat}}%</strong></span>
  </footer>
</body>
</html>