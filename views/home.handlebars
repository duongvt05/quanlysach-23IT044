<style>
  .alert{
    padding:12px 16px; border-radius:10px; margin-bottom:20px;
    font-weight:500; display:flex; align-items:center; gap:10px;
    transition:opacity .5s;
  }
  .alert.success{background:var(--ok-bg); color:var(--ok-text); border:1px solid var(--ok-border)}
  .alert.error{background:var(--err-bg); color:var(--err-text); border:1px solid var(--err-border)}

  form.grid{display:grid; grid-template-columns:1fr 1fr; gap:14px}
  .field{display:flex; flex-direction:column; gap:6px}
  .field.full{grid-column:1 / -1}
  label{font-size:.85rem; font-weight:600; color:var(--muted)}
  input{
    padding:10px 12px; border:1px solid var(--border); border-radius:8px;
    background:var(--card); color:var(--text); font-size:.95rem; font-family:inherit;
  }
  input:focus{outline:none; border-color:var(--primary); box-shadow:0 0 0 3px rgba(99,102,241,.25)}
  .hint{font-size:.8rem; color:var(--muted)}
  button{
    background:var(--primary); color:#fff; border:none; padding:11px 22px;
    border-radius:8px; font-size:.95rem; font-weight:600; cursor:pointer;
    transition:background .15s, transform .05s;
  }
  button:hover{background:var(--primary-hover)}
  button:active{transform:scale(.98)}

  .pill{
    background:var(--badge-bg); color:var(--badge-text);
    padding:4px 12px; border-radius:999px; font-size:.8rem; font-weight:600;
  }
  .table-wrap{overflow-x:auto}
  table{width:100%; border-collapse:collapse; min-width:620px}
  th,td{padding:12px 14px; text-align:left; border-bottom:1px solid var(--border)}
  th{background:var(--th); font-size:.8rem; text-transform:uppercase; letter-spacing:.5px; color:var(--muted)}
  tbody tr:hover{background:var(--row-hover)}
  td.num, th.num{text-align:right}
  .code{font-family:Consolas,monospace; font-weight:600; color:var(--primary)}
  .badge{background:var(--badge-bg); color:var(--badge-text); padding:2px 9px; border-radius:6px; font-size:.82rem; font-weight:600}
  .total{font-weight:700}
  .empty{text-align:center; color:var(--muted); padding:36px 0}

  @media (max-width:600px){
    form.grid{grid-template-columns:1fr}
  }
</style>

{{#if flash}}
  <div class="alert {{flash.type}}" id="flash">
    {{#if (eq flash.type "success")}}✅{{else}}⚠️{{/if}} {{flash.text}}
  </div>
{{/if}}

<section class="card">
  <h2>➕ Thêm sách mới</h2>
  <form method="POST" action="/books" class="grid">
    <div class="field">
      <label for="code">Mã sản phẩm</label>
      <input id="code" name="code" placeholder="{{prefix}}-001" required autocomplete="off">
      <span class="hint">Bắt buộc bắt đầu bằng <strong>{{prefix}}</strong></span>
    </div>
    <div class="field">
      <label for="name">Tên sách</label>
      <input id="name" name="name" placeholder="Ví dụ: Đắc Nhân Tâm" required>
    </div>
    <div class="field">
      <label for="author">Tác giả</label>
      <input id="author" name="author" placeholder="Không bắt buộc">
    </div>
    <div class="field">
      <label for="price">Giá gốc (VNĐ)</label>
      <input id="price" name="price" type="number" min="1" placeholder="100000" required>
    </div>
    <div class="field full">
      <button type="submit">Thêm sách</button>
    </div>
  </form>
</section>

<section class="card">
  <div class="card-head">
    <h2>📖 Danh sách sách ({{books.length}})</h2>
    <span class="pill">☁️ Phiên làm việc lưu trên Atlas · Lượt truy cập: {{visits}}</span>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Mã</th><th>Tên sách</th><th>Tác giả</th>
          <th class="num">Giá gốc</th><th>VAT</th><th class="num">Giá sau thuế</th>
        </tr>
      </thead>
      <tbody>
        {{#each books}}
        <tr>
          <td class="code">{{code}}</td>
          <td>{{name}}</td>
          <td>{{author}}</td>
          <td class="num">{{price}} ₫</td>
          <td><span class="badge">{{vat}}%</span></td>
          <td class="num total">{{priceAfterTax}} ₫</td>
        </tr>
        {{else}}
        <tr><td colspan="6" class="empty">📭 Chưa có sách nào</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>

<script>
  const f = document.getElementById('flash');
  if (f) setTimeout(() => { f.style.opacity = 0; }, 4000);
</script>